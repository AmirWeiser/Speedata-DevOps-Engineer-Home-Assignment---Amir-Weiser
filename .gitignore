*.pem
*.key
id_rsa*
id_ed25519*
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Ansible ---
*.retry

