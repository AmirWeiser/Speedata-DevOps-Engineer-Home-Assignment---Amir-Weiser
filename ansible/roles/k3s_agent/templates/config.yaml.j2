# Managed by Ansible (k3s_agent role). Do not edit on the host.
node-name: {{ inventory_hostname }}
node-ip: {{ private_ip }}
# Private IP: node-to-node traffic stays inside the VPC and the cluster security group.
server: https://{{ hostvars[groups['k3s_server'][0]].private_ip }}:6443
token: {{ hostvars[groups['k3s_server'][0]].k3s_server_token }}
